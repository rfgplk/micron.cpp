// [meta.reflection.layout]
struct member_offset {
  ptrdiff_t bytes;
  ptrdiff_t bits;

  constexpr ptrdiff_t
  total_bits() const
  {
    return bytes * __CHAR_BIT__ + bits;
  }

  auto operator<=>(const member_offset &) const = default;
};

