using info = decltype(^^int);

struct __sv {
  const char *__p = nullptr;
  usize __n = 0;

  consteval __sv() noexcept = default;

  consteval __sv(const char *__s) noexcept : __p(__s)
  {
    while ( __s[__n] ) ++__n;
  }

  consteval const char *
  data() const noexcept
  {
    return __p;
  }

  consteval usize
  size() const noexcept
  {
    return __n;
  }

  consteval char
  operator[](usize __i) const noexcept
  {
    return __p[__i];
  }
};

// [meta.reflection.exception]
class exception
{
  const char *_M_what;
  info _M_from;

public:
  consteval exception(__sv __what, info __from) noexcept : _M_what(__what.data()), _M_from(__from) {}

  consteval exception(const exception &) = default;
  consteval exception(exception &&) = default;

  consteval const char *
  what() const noexcept
  {
    return _M_what;
  }

  consteval info
  from() const noexcept
  {
    return _M_from;
  }
};

template<class _Rg>
concept reflection_range = requires(_Rg &&__r) {
  __r.begin();
  __r.end();
  requires __is_same(ranges::range_value_t<_Rg>, info);
};

