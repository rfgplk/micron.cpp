namespace ranges
{
// reflect_constant_string() is routinely handed a string literal, so the array case has to be here
// as well as the member-begin() one
template<class R> struct __rng_ref {
  using type = decltype(*__micron_declval<R &>().begin());
};

template<class T, usize N> struct __rng_ref<T[N]> {
  using type = T &;
};

template<class R> using range_reference_t = typename __rng_ref<__remove_reference(R)>::type;
template<class R> using range_value_t = __remove_cv(__remove_reference(range_reference_t<R>));

struct __begin_fn {
  template<class R>
  constexpr auto
  operator()(R &&__r) const
  {
    return __r.begin();
  }

  template<class T, usize N>
  constexpr T *
  operator()(T (&__a)[N]) const
  {
    return __a;
  }
};

struct __end_fn {
  template<class R>
  constexpr auto
  operator()(R &&__r) const
  {
    return __r.end();
  }

  template<class T, usize N>
  constexpr T *
  operator()(T (&__a)[N]) const
  {
    return __a + N;
  }
};

struct __size_fn {
  template<class R>
  constexpr auto
  operator()(R &&__r) const
  {
    return __r.size();
  }

  template<class T, usize N>
  constexpr usize
  operator()(T (&)[N]) const
  {
    return N;
  }
};

inline constexpr __begin_fn begin{};
inline constexpr __end_fn end{};
inline constexpr __size_fn size{};
};     // namespace ranges

