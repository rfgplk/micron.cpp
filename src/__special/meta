// [meta.reflection.access.context]
struct access_context {
private:
  consteval access_context(info __scope, info __designating_class) noexcept : _M_scope{ __scope }, _M_designating_class{ __designating_class } {}

public:
  access_context() = delete;
  consteval access_context(const access_context &) = default;
  consteval access_context(access_context &&) = default;

  consteval info
  scope() const
  {
    return _M_scope;
  }

  consteval info
  designating_class() const
  {
    return _M_designating_class;
  }

  static consteval access_context current() noexcept;

  static consteval access_context
  unprivileged() noexcept
  {
    return access_context{ ^^::, info{} };
  }

  static consteval access_context
  unchecked() noexcept
  {
    return access_context{ info{}, info{} };
  }

  consteval access_context via(info) const;

  info _M_scope;
  info _M_designating_class;
};

