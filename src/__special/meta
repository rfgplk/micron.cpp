// needed, gcc looks these up by name
template<class T> class allocator;

// consteval-only
template<class T, class A = allocator<T>> class vector
{
  T *__mem = nullptr;
  usize __len = 0;

public:
  using value_type = T;
  using size_type = usize;

  constexpr vector() noexcept = default;

  constexpr vector(initializer_list<T> __il) : __len(__il.size())
  {
    __mem = __len ? new T[__len] : nullptr;
    for ( usize i = 0; i < __len; ++i ) __mem[i] = __il.begin()[i];
  }

  constexpr vector(const vector &__o) : __len(__o.__len)
  {
    __mem = __len ? new T[__len] : nullptr;
    for ( usize i = 0; i < __len; ++i ) __mem[i] = __o.__mem[i];
  }

  constexpr vector &
  operator=(const vector &__o)
  {
    if ( this == &__o ) return *this;
    if ( __mem ) delete[] __mem;
    __len = __o.__len;
    __mem = __len ? new T[__len] : nullptr;
    for ( usize i = 0; i < __len; ++i ) __mem[i] = __o.__mem[i];
    return *this;
  }

  constexpr ~vector()
  {
    if ( __mem ) delete[] __mem;
  }

  constexpr usize
  size() const noexcept
  {
    return __len;
  }

  constexpr bool
  empty() const noexcept
  {
    return __len == 0;
  }

  constexpr const T *
  begin() const noexcept
  {
    return __mem;
  }

  constexpr const T *
  end() const noexcept
  {
    return __mem + __len;
  }

  constexpr const T &
  operator[](usize __i) const noexcept
  {
    return __mem[__i];
  }
};

