[
  "/usr/bin/clang++",
  "-std=c++23",
  "-S",
  "-O3",
  "-march=x86-64-v3",
  "-m64",
  "-Wall",
  "-Wextra",
  "-Wpedantic",
  "-Wno-variadic-macros",
  "-Wno-inline",
  "-fno-stack-protector",
  "-fstack-clash-protection",
  "-fstrict-overflow",
  "-fno-lto",
  "-funroll-loops",
  "-fno-omit-frame-pointer",
  "-fdiagnostics-color=always",
  "tests/build/fft_codegen.cpp",
  "-I.",
  "-I./src",
  "-o",
  "bin/fft/tuning/codegen/final-clang/fft_codegen.s",
  "-fstack-usage",
  "-Rpass=loop-vectorize|slp-vectorizer",
  "-Rpass-missed=loop-vectorize|slp-vectorizer",
  "-Rpass-analysis=loop-vectorize|slp-vectorizer"
]
