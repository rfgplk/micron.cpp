[
  "/usr/bin/g++",
  "-std=c++23",
  "-S",
  "-O3",
  "-fmodulo-sched",
  "-fmodulo-sched-allow-regmoves",
  "-fgcse-sm",
  "-fgcse-las",
  "-march=x86-64-v3",
  "-m64",
  "-Wall",
  "-Wextra",
  "-Wpedantic",
  "-Wno-variadic-macros",
  "-Wno-inline",
  "-fno-stack-protector",
  "-fstack-clash-protection",
  "-fstrict-overflow",
  "-fext-numeric-literals",
  "-fno-lto",
  "-funroll-loops",
  "-fno-omit-frame-pointer",
  "-fdiagnostics-color=always",
  "-fconcepts-diagnostics-depth=2",
  "tests/build/fft_codegen.cpp",
  "-I.",
  "-I./src",
  "-o",
  "bin/fft/tuning/codegen/final-gcc/fft_codegen.s",
  "-fstack-usage",
  "-fopt-info-vec-all=bin/fft/tuning/codegen/final-gcc/vectorization.txt"
