          "runtime_host_lifecycle.mjs"
        ]
      },
      {
        "id": "WASM-REV-02",
        "fix": "Reject new RPCs during shared shutdown, share its promise and settle pending calls on termination.",
        "tests": [
          "runtime_lifecycle.mjs",
          "runtime_host_lifecycle.mjs"
        ]
      },
      {
        "id": "WASM-REV-03",
        "fix": "Public cancellation wakes checkpoints, parks and replaces the worker, cleans up TLS/hooks and reaps before returning.",
        "tests": [
          "runtime_cancel.cpp",
          "runtime_cancel_eh.cpp",
          "runtime_thread_fuzz.cpp",
          "runtime_host_lifecycle.mjs"
        ]
      },
      {
        "id": "WASM-REV-04",
        "fix": "Bound join waits and revalidate slot generation after waking, including copied competing handles.",
        "tests": [
          "runtime_join_reuse.cpp",
          "runtime_thread_fuzz.cpp"
        ]
      },
      {
        "id": "WASM-REV-05",
        "fix": "Exclude bool and unsupported integer lane types before arbitrary SIMD bit representations are constructed.",
        "tests": [
          "simd.cpp",
          "fuzz_simd.cpp"
        ]
      },
      {
        "id": "WASM-REV-06",
        "fix": "Preserve quotient parity for binary128 halfway remainder when twice the divisor overflows.",
        "tests": [
          "math_edges.cpp",
          "numeric_oracle.mjs"
        ]
      },
      {
        "id": "WASM-REV-07",
        "fix": "Preserve gamma overflow classification and avoid intermediate overflow when lgamma remains finite.",
        "tests": [
          "math_edges.cpp",
          "fuzz_math_reference.json"
        ]
      },
      {
        "id": "WASM-REV-08",
        "fix": "Check integer scaling and floating duration range before signed arithmetic or conversion.",
        "tests": [
          "fuzz_chrono.cpp"
        ]
      }
    ]
  },
  "additional_fixes": [
    "Track live EH allocations through cancellation and destroy eligible exception objects before TLS cleanup; do not restart incomplete construction or an entered destructor.",
    "Improve binary128 gamma near roots/poles, erfc tails, Bessel tiny arguments and near-unity large integer powers; preserve the existing 128 ULP extended-policy limit.",
    "Make Wasm 128-bit shift helpers tolerate compiler-speculated discarded poison values while preserving frontend UBSan checks for invalid source operations.",
    "Replace inactive-union punning in the Wasm multiply helper with bit_cast.",
    "Reject empty/duplicate test selections and malformed coverage exports; correctly grade unsigned high-bit assertion counts."
  ],
