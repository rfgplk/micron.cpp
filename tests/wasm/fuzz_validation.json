  "limitations": [
    "Finite fixed-seed tests do not prove absence of C++ UB, aliasing errors, within-heap corruption or data races. Wasm bounds checks alone cannot detect those classes.",
    "Browser claims cover the listed Playwright engine versions, not every deployed browser or shipping Safari configuration. Shared memory requires cross-origin isolation.",
    "UBSan vptr instrumentation is excluded because the micron-only runtime does not provide that sanitizer ABI. No ASan/TSan runtime is linked.",
    "Cancellation has explicit thread-exit semantics and does not unwind abandoned automatic objects. Caller-managed stack resources remain the caller responsibility; guarded initialization, EH allocations, TLS and exit hooks are cleaned up.",
    "Binary128 transcendental functions retain the documented extended approximation policy, not a universal correctly-rounded guarantee.",
    "No Canvas implementation, WASI/Emscripten/Memory64 support, native filesystem/process/GPU emulation, or abcmalloc changes are part of this work."
  ],
  "reproduce": [
    "python3 tests/wasm/suite.py --jobs 4 --oracles --output bin/wasm-fixes-complete",
    "node tests/wasm/browser.mjs --manifest=bin/wasm-fixes-complete/modules.json --output=bin/wasm-fixes-complete/browsers.json",
    "python3 tests/wasm/fuzz.py --profiles scalar,simd-threads-eh --seeds 0x243f6a88,0x9e3779b9,0xb7e15162 --select fuzz_memory,fuzz_simd,fuzz_chrono,fuzz_eh,runtime_thread_fuzz,numeric --jobs 3 --optimization O3 --ubsan-traps --output bin/wasm-fixes-fuzz-fixed",
    "python3 tests/wasm/grading_controls.py --browsers",
    "node tests/wasm/numeric_ubsan_controls.mjs bin/wasm-fixes-fuzz-fixed/243f6a88/scalar/numeric.wasm",
    "python3 tests/wasm/fuzz.py --jobs 4 --browsers",
    "node tests/wasm/simd_math_benchmark.mjs --build > benches/results/wasm_math_simd.json"
  ],
