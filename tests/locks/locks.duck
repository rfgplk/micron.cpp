# the locking + atomics validation battery
#
#   duck tests/locks/locks.duck                (== duck batch tests/locks/locks.duck)
#   duck batch parallel tests/locks/locks.duck
#
# amd64, hosted, default optimization

test tests/rigor/mutex_null_lock.cpp -o bin/locks/x64 --timeout 120
test tests/rigor/mutex_barrier.cpp -o bin/locks/x64 --timeout 120
test tests/rigor/mutex_auto_guard.cpp -o bin/locks/x64 --timeout 120
test tests/rigor/mutex_token.cpp -o bin/locks/x64 --timeout 120

# deadlock battery




# lock-misuse


# forced degradation
#   MICRON_LOCK_SPIN_ROUNDS=0   park (or yield) on the FIRST failed acquire
#   MICRON_LOCK_YIELD_ROUNDS=0  no yield tier at all: pause straight to park
#   MICRON_LOCK_SPIN_LIMIT=1    no exponential growth, one pause per round
#   MICRON_MCS_DEPTH=1          one queue-lock slot per thread: the eviction path in
#                               __node_pool.hpp, which is otherwise never reached



# optimization sweep


# SSE2 floor


# aarch64 under qemu-aarch64-static -- WEAK MEMORY

test tests/rigor/mutex_barrier.cpp --arm64 -s -o bin/locks/arm64 --timeout 600


# armv7-a under qemu-arm-static

test tests/rigor/mutex_barrier.cpp --arm -s -o bin/locks/arm32 --timeout 600

# ThreadSanitizer


# deep soaks



# freestanding: build+link only. -k has no exceptions, so the throwing paths in __node_pool.hpp
# and clh_lock.hpp must still compile there.

build tests/compiletests/locks.cpp -k -o bin/locks/free
build tests/compiletests/locks.cpp -ke -o bin/locks/free
