test tests/rigor/sync_inlet_queuing.cpp --arm64 -s -o bin/locks/arm64 --timeout 600

test tests/rigor/mutex_deadlock_family.cpp --arm64 -s -o bin/locks/arm64 --timeout 900
test tests/rigor/mutex_mcs_regression.cpp --arm64 -s -o bin/locks/arm64 --timeout 600
test tests/rigor/mutex_clh_regression.cpp --arm64 -s -o bin/locks/arm64 --timeout 600

