test tests/rigor/atomic_ptr_rmw.cpp --arm -s -o bin/locks/arm32 --timeout 600
test tests/rigor/mutex_ttas.cpp --arm -s -o bin/locks/arm32 --timeout 600
test tests/rigor/mutex_ticket.cpp --arm -s -o bin/locks/arm32 --timeout 600
test tests/rigor/mutex_mcs_lock.cpp --arm -s -o bin/locks/arm32 --timeout 600
test tests/rigor/mutex_clh_lock.cpp --arm -s -o bin/locks/arm32 --timeout 600
test tests/rigor/mutex_futex.cpp --arm -s -o bin/locks/arm32 --timeout 900
test tests/rigor/mutex_shared.cpp --arm -s -o bin/locks/arm32 --timeout 600
test tests/rigor/mutex_seqlock.cpp --arm -s -o bin/locks/arm32 --timeout 600
test tests/rigor/mutex_weak_mutex.cpp --arm -s -o bin/locks/arm32 --timeout 900
