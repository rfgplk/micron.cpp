test tests/rigor/mutex_mcs_lock.cpp --arm64 -s -o bin/locks/arm64 --timeout 600
test tests/rigor/mutex_clh_lock.cpp --arm64 -s -o bin/locks/arm64 --timeout 600
test tests/rigor/mutex_futex.cpp --arm64 -s -o bin/locks/arm64 --timeout 900
test tests/rigor/mutex_shared.cpp --arm64 -s -o bin/locks/arm64 --timeout 600
test tests/rigor/mutex_seqlock.cpp --arm64 -s -o bin/locks/arm64 --timeout 600
test tests/rigor/mutex_weak_mutex.cpp --arm64 -s -o bin/locks/arm64 --timeout 900
