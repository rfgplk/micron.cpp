test tests/rigor/atomic_intrin.cpp --arm64 -s -o bin/locks/arm64 --timeout 300
test tests/rigor/atomic_ptr_rmw.cpp --arm64 -s -o bin/locks/arm64 --timeout 600
test tests/rigor/atomic_locked_view.cpp --arm64 -s -o bin/locks/arm64 --timeout 600
