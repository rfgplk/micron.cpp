test tests/rigor/mutex_ttas.cpp --tsan -o bin/locks/tsan --timeout 600
test tests/rigor/mutex_weak_mutex.cpp --tsan -o bin/locks/tsan --timeout 900
test tests/rigor/mutex_ticket.cpp --tsan -o bin/locks/tsan --timeout 600
test tests/rigor/mutex_mcs_lock.cpp --tsan -o bin/locks/tsan --timeout 600
