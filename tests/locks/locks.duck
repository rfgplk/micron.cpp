# the locking + atomics validation battery
#
#   duck tests/locks/locks.duck                (== duck batch tests/locks/locks.duck)
#   duck batch parallel tests/locks/locks.duck
#
# amd64, hosted, default optimization

test tests/rigor/mutex_basic.cpp -o bin/locks/x64 --timeout 120
test tests/rigor/mutex_fast_mutex.cpp -o bin/locks/x64 --timeout 120
test tests/rigor/mutex_null_lock.cpp -o bin/locks/x64 --timeout 120
test tests/rigor/mutex_spin_lock.cpp -o bin/locks/x64 --timeout 120
test tests/rigor/mutex_recursive.cpp -o bin/locks/x64 --timeout 120
test tests/rigor/mutex_ttas.cpp -o bin/locks/x64 --timeout 180
test tests/rigor/mutex_ticket.cpp -o bin/locks/x64 --timeout 180
test tests/rigor/mutex_mcs_lock.cpp -o bin/locks/x64 --timeout 180
test tests/rigor/mutex_clh_lock.cpp -o bin/locks/x64 --timeout 180
test tests/rigor/mutex_futex.cpp -o bin/locks/x64 --timeout 240
test tests/rigor/mutex_shared.cpp -o bin/locks/x64 --timeout 180
test tests/rigor/mutex_seqlock.cpp -o bin/locks/x64 --timeout 180
test tests/rigor/mutex_weak_mutex.cpp -o bin/locks/x64 --timeout 300
test tests/rigor/mutex_barrier.cpp -o bin/locks/x64 --timeout 120
test tests/rigor/mutex_multilock.cpp -o bin/locks/x64 --timeout 240
test tests/rigor/mutex_exclusion.cpp -o bin/locks/x64 --timeout 300
test tests/rigor/mutex_queuing.cpp -o bin/locks/x64 --timeout 120
test tests/rigor/mutex_scoped_lock.cpp -o bin/locks/x64 --timeout 120
test tests/rigor/mutex_lock_guard.cpp -o bin/locks/x64 --timeout 120
test tests/rigor/mutex_unique_lock.cpp -o bin/locks/x64 --timeout 120
test tests/rigor/mutex_auto_guard.cpp -o bin/locks/x64 --timeout 120
test tests/rigor/mutex_once.cpp -o bin/locks/x64 --timeout 120
test tests/rigor/mutex_token.cpp -o bin/locks/x64 --timeout 120
test tests/rigor/mutex_token_mt.cpp -o bin/locks/x64 --timeout 180
test tests/rigor/atomic_atomic.cpp -o bin/locks/x64 --timeout 120
test tests/rigor/atomic_flag.cpp -o bin/locks/x64 --timeout 120
test tests/rigor/atomic_intrin.cpp -o bin/locks/x64 --timeout 120
test tests/rigor/atomic_ptr_rmw.cpp -o bin/locks/x64 --timeout 180
test tests/rigor/atomic_locked_view.cpp -o bin/locks/x64 --timeout 180
test tests/rigor/atomic_litmus.cpp -o bin/locks/x64 --timeout 240
test tests/rigor/sync_futex.cpp -o bin/locks/x64 --timeout 120
test tests/rigor/sync_event_count.cpp -o bin/locks/x64 --timeout 180
test tests/rigor/sync_semaphore.cpp -o bin/locks/x64 --timeout 120
test tests/rigor/sync_semaphore_permits.cpp -o bin/locks/x64 --timeout 180
test tests/rigor/sync_inlet.cpp -o bin/locks/x64 --timeout 120
test tests/rigor/sync_inlet_queuing.cpp -o bin/locks/x64 --timeout 180
test tests/rigor/sync_latch.cpp -o bin/locks/x64 --timeout 120
test tests/rigor/sync_barrier.cpp -o bin/locks/x64 --timeout 120

# deadlock battery

test tests/rigor/mutex_deadlock_family.cpp -o bin/locks/x64 --timeout 300
test tests/rigor/mutex_mcs_regression.cpp -o bin/locks/x64 --timeout 180
test tests/rigor/mutex_clh_regression.cpp -o bin/locks/x64 --timeout 240

test tests/rigor/mutex_ttas.cpp --def MICRON_LOCK_STATS -o bin/locks/stats --timeout 240
test tests/rigor/mutex_futex.cpp --def MICRON_LOCK_STATS -o bin/locks/stats --timeout 300
test tests/rigor/mutex_ticket.cpp --def MICRON_LOCK_STATS -o bin/locks/stats --timeout 240
test tests/rigor/mutex_exclusion.cpp --def MICRON_LOCK_STATS -o bin/locks/stats --timeout 400

test tests/rigor/mutex_deadlock_family.cpp --def MICRON_LOCK_STATS -o bin/locks/stats --timeout 300

# lock-misuse

test tests/rigor/mutex_recursive.cpp --def MICRON_LOCK_DEBUG -o bin/locks/debug --timeout 120
test tests/rigor/mutex_mcs_lock.cpp --def MICRON_LOCK_DEBUG -o bin/locks/debug --timeout 180
test tests/rigor/mutex_clh_lock.cpp --def MICRON_LOCK_DEBUG -o bin/locks/debug --timeout 180
test tests/rigor/mutex_ticket.cpp --def MICRON_LOCK_DEBUG -o bin/locks/debug --timeout 180
test tests/rigor/mutex_queuing.cpp --def MICRON_LOCK_DEBUG -o bin/locks/debug --timeout 120
test tests/rigor/mutex_exclusion.cpp --def MICRON_LOCK_DEBUG -o bin/locks/debug --timeout 400

# forced degradation
#   MICRON_LOCK_SPIN_ROUNDS=0   park (or yield) on the FIRST failed acquire
#   MICRON_LOCK_YIELD_ROUNDS=0  no yield tier at all: pause straight to park
#   MICRON_LOCK_SPIN_LIMIT=1    no exponential growth, one pause per round
#   MICRON_MCS_DEPTH=1          one queue-lock slot per thread: the eviction path in
#                               __node_pool.hpp, which is otherwise never reached

test tests/rigor/mutex_futex.cpp --def MICRON_LOCK_SPIN_ROUNDS=0u -o bin/locks/nospin --timeout 300
test tests/rigor/mutex_ttas.cpp --def MICRON_LOCK_YIELD_ROUNDS=0u -o bin/locks/noyield --timeout 240
test tests/rigor/mutex_ticket.cpp --def MICRON_LOCK_SPIN_LIMIT=1u -o bin/locks/nogrow --timeout 240
test tests/rigor/mutex_exclusion.cpp --def MICRON_LOCK_SPIN_LIMIT=1u -o bin/locks/nogrow --timeout 400
test tests/rigor/mutex_basic.cpp --def MICRON_LOCK_SPIN_ROUNDS=0u -o bin/locks/nospin --timeout 180
test tests/rigor/mutex_fast_mutex.cpp --def MICRON_LOCK_SPIN_ROUNDS=0u -o bin/locks/nospin --timeout 180
test tests/rigor/mutex_weak_mutex.cpp --def MICRON_LOCK_SPIN_ROUNDS=0u -o bin/locks/nospin --timeout 400
test tests/rigor/mutex_recursive.cpp --def MICRON_LOCK_YIELD_ROUNDS=0u -o bin/locks/noyield --timeout 180
test tests/rigor/mutex_queuing.cpp --def MICRON_LOCK_SPIN_LIMIT=1u -o bin/locks/nogrow --timeout 180
test tests/rigor/mutex_spin_lock.cpp --def MICRON_LOCK_SPIN_LIMIT=1u -o bin/locks/nogrow --timeout 180
test tests/rigor/mutex_mcs_lock.cpp --def MICRON_MCS_DEPTH=1 -o bin/locks/depth1 --timeout 180
test tests/rigor/mutex_clh_lock.cpp --def MICRON_MCS_DEPTH=1 -o bin/locks/depth1 --timeout 180

test tests/rigor/mutex_deadlock_family.cpp --def MICRON_MCS_DEPTH=1 -o bin/locks/depth1 --timeout 300
test tests/rigor/mutex_mcs_regression.cpp --def MICRON_MCS_DEPTH=1 -o bin/locks/depth1 --timeout 180
test tests/rigor/mutex_clh_regression.cpp --def MICRON_MCS_DEPTH=1 -o bin/locks/depth1 --timeout 240
test tests/rigor/mutex_deadlock_family.cpp --def MICRON_LOCK_SPIN_ROUNDS=0u -o bin/locks/nospin --timeout 300
test tests/rigor/mutex_deadlock_family.cpp --def MICRON_LOCK_SPIN_LIMIT=1u -o bin/locks/nogrow --timeout 300

# optimization sweep

test tests/rigor/atomic_litmus.cpp -O0 -o bin/locks/O0 --timeout 300
test tests/rigor/mutex_exclusion.cpp -O0 -o bin/locks/O0 --timeout 400
test tests/rigor/mutex_seqlock.cpp -O0 -o bin/locks/O0 --timeout 240
test tests/rigor/mutex_multilock.cpp -O0 -o bin/locks/O0 --timeout 300
test tests/rigor/mutex_deadlock_family.cpp -O0 -o bin/locks/O0 --timeout 400
test tests/rigor/mutex_mcs_regression.cpp -O0 -o bin/locks/O0 --timeout 240
test tests/rigor/mutex_clh_regression.cpp -O0 -o bin/locks/O0 --timeout 300

# SSE2 floor

test tests/rigor/atomic_litmus.cpp --isa base -o bin/locks/base --timeout 300
test tests/rigor/mutex_exclusion.cpp --isa base -o bin/locks/base --timeout 400
test tests/rigor/atomic_ptr_rmw.cpp --isa base -o bin/locks/base --timeout 240
test tests/rigor/mutex_deadlock_family.cpp --isa base -o bin/locks/base --timeout 300
test tests/rigor/mutex_mcs_regression.cpp --isa base -o bin/locks/base --timeout 180
test tests/rigor/mutex_clh_regression.cpp --isa base -o bin/locks/base --timeout 240

# aarch64 under qemu-aarch64-static -- WEAK MEMORY

test tests/rigor/atomic_litmus.cpp --arm64 -s -o bin/locks/arm64 --timeout 600
