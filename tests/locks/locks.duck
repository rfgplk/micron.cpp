# deep soaks

test tests/stress/lock_adversarial.cpp -o bin/locks/soak --timeout 600
test tests/stress/lock_deadlock_fuzz.cpp -o bin/locks/soak --timeout 600
test tests/stress/lock_deadlock_fuzz.cpp --def STRESS_SCALE=10 -o bin/locks/soak10 --timeout 1800
test tests/stress/lock_adversarial.cpp --def STRESS_SCALE=4 -o bin/locks/soak4 --timeout 1800

test tests/rigor/mutex_deadlock_family.cpp --def LOCK_DF_SCALE=4 -o bin/locks/soak4 --timeout 900
test tests/rigor/mutex_clh_regression.cpp --def CLH_REG_SCALE=4 -o bin/locks/soak4 --timeout 600
test tests/rigor/mutex_mcs_regression.cpp --def MCS_REG_ITERS=20000 -o bin/locks/soak4 --timeout 600

# freestanding: build+link only. -k has no exceptions, so the throwing paths in __node_pool.hpp
# and clh_lock.hpp must still compile there.

build tests/compiletests/locks.cpp -k -o bin/locks/free
build tests/compiletests/locks.cpp -ke -o bin/locks/free
