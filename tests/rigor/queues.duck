# queue correctness, lifetime, exception, and fixed-seed concurrency fuzzing
#
#   duck tests/rigor/queues.duck

# %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# default build: legacy regressions plus the expanded Snowball fuzz suites
test tests/rigor/queue.cpp                 -o bin/queues/default --timeout 300 -f
test tests/rigor/fuzz_queues.cpp            -o bin/queues/default --timeout 300 -f
test tests/rigor/fuzz_queue_lifetime.cpp    -o bin/queues/default --timeout 300 -f
test tests/rigor/immutable_queue.cpp        -o bin/queues/default --timeout 300 -f
test tests/rigor/queue_exceptions.cpp       -o bin/queues/default --timeout 300 -f

# %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# optimizer and oldest-amd64-ISA cells
test tests/rigor/fuzz_queues.cpp            -o bin/queues/o2 -O2 --timeout 300 -f
test tests/rigor/fuzz_queue_lifetime.cpp    -o bin/queues/o2 -O2 --timeout 300 -f
test tests/rigor/immutable_queue.cpp        -o bin/queues/o2 -O2 --timeout 300 -f

test tests/rigor/fuzz_queues.cpp            -o bin/queues/base --isa base --timeout 300 -f
test tests/rigor/fuzz_queue_lifetime.cpp    -o bin/queues/base --isa base --timeout 300 -f
test tests/rigor/immutable_queue.cpp        -o bin/queues/base --isa base --timeout 300 -f

# %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# manual-lifetime and publication paths under sanitizers
test tests/rigor/fuzz_queues.cpp            -o bin/queues/asan_ubsan --asan --ubsan --timeout 600 -f
test tests/rigor/fuzz_queue_lifetime.cpp    -o bin/queues/asan_ubsan --asan --ubsan --timeout 600 -f
test tests/rigor/immutable_queue.cpp        -o bin/queues/asan_ubsan --asan --ubsan --timeout 600 -f
test tests/rigor/queue_exceptions.cpp       -o bin/queues/asan_ubsan --asan --ubsan --timeout 600 -f

# Clang owns a complete TSan runtime on the development hosts.

# %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# pointer-width, weak-memory, and exception-runtime execution cells
test tests/rigor/fuzz_queues.cpp            -o bin/queues/arm --arm --timeout 600 -f
test tests/rigor/fuzz_queue_lifetime.cpp    -o bin/queues/arm --arm --timeout 600 -f
test tests/rigor/immutable_queue.cpp        -o bin/queues/arm --arm --timeout 600 -f

test tests/rigor/fuzz_queues.cpp            -o bin/queues/arm64 --arm64 --timeout 600 -f
test tests/rigor/fuzz_queue_lifetime.cpp    -o bin/queues/arm64 --arm64 --timeout 600 -f
test tests/rigor/immutable_queue.cpp        -o bin/queues/arm64 --arm64 --timeout 600 -f

test tests/rigor/queue_exceptions.cpp -o bin/queues/eh -ke --start ./start -i . -i ./src --timeout 300 -f
