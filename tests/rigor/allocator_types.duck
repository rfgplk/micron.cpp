# allocator traits, static allocator family, explicit arenas, and advanced abcmalloc adapters
test tests/rigor/allocator_edge_cases.cpp -o bin/allocator/x64 --timeout 300
test tests/rigor/allocator_fuzz.cpp -o bin/allocator/x64 --timeout 300
test tests/rigor/allocator_traits.cpp -o bin/allocator/x64 --timeout 300

# sanitizer-owned heap coverage; deliberate protection faults are compiled out by the tests
test tests/rigor/allocator_edge_cases.cpp --asan -o bin/allocator/asan --timeout 300
test tests/rigor/allocator_fuzz.cpp --asan -o bin/allocator/asan --timeout 300
test tests/rigor/allocator_edge_cases.cpp --ubsan -o bin/allocator/ubsan --timeout 300
test tests/rigor/allocator_fuzz.cpp --ubsan -o bin/allocator/ubsan --timeout 300
