# %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# vk host allocator
# the tests/compiletests/ sweep above already carries vk_headers.cpp with the counters OFF; these
# rows are the ON column. the block header keeps one layout either way, so what is actually under
# test here is the gated code, not a second ABI.
compile --clang tests/compiletests/vk_headers.cpp --x86 -Ofast --def MICRON_VK_HOST_STATS -i . -o bin/compiletests-clang/vk_stats_x86
compile --clang tests/compiletests/vk_headers.cpp --i386 -Ofast --def MICRON_VK_HOST_STATS -i . -o bin/compiletests-clang/vk_stats_i386
compile --clang tests/compiletests/vk_headers.cpp --arm -Ofast --def MICRON_VK_HOST_STATS -i . -o bin/compiletests-clang/vk_stats_arm32
compile --clang tests/compiletests/vk_headers.cpp --arm64 -Ofast --def MICRON_VK_HOST_STATS -i . -o bin/compiletests-clang/vk_stats_arm64
compile --clang tests/compiletests/vk_headers.cpp --x86 --isa base -O2 --def MICRON_VK_HOST_STATS -i . -o bin/compiletests-clang/vk_stats_base
compile --clang tests/rigor/vk_allocator.cpp --x86 -Ofast --def MICRON_VK_HOST_STATS -i . -o bin/compiletests-clang/vk_alloc_stats_x86
compile --clang tests/rigor/vk_allocator.cpp --arm -Ofast --def MICRON_VK_HOST_STATS -i . -o bin/compiletests-clang/vk_alloc_stats_arm32

# %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# libstdc++ interop -- BOTH include orders, BOTH compilers
# libc_interop.cpp is the gate on micron's headers coexisting with libstdc++ in one TU, and the ORDER
# is the claim, so it is built twice: default = micron first, --def MICRON_INTEROP_STD_FIRST =
# libstdc++ first. Each order used to fail on its own axis. micron is time64 and glibc is time32 on
# ILP32, so a global ::time_t took out both orders on arm32/i386. arm32's <asm/types.h>, which
# <chrono> reaches, rewrites __UINTPTR_TYPE__, so types.hpp's size_t forked from glibc's under
# std-first. clang rejected micron's std::align_val_t against the <new> that <map>/<string> pull in,
# under micron-first. And __special/coroutine guarded itself privately, so it collided both ways.
# HOSTED ROWS ONLY -- it must never be swept under -k/-ke, where bits/__ctasserts.hpp #errors on
# _STDLIB_H by design, which is also why it cannot live in tests/compiletests/ (that directory is
# swept as a whole).
compile --clang tests/rigor/libc_interop.cpp --x86 -O2 -i . -o bin/compiletests-clang/libc_interop_x86
compile --clang tests/rigor/libc_interop.cpp --i386 -O2 -i . -o bin/compiletests-clang/libc_interop_i386
compile --clang tests/rigor/libc_interop.cpp --arm -O2 -i . -o bin/compiletests-clang/libc_interop_arm32
compile --clang tests/rigor/libc_interop.cpp --arm64 -O2 -i . -o bin/compiletests-clang/libc_interop_arm64
compile --clang tests/rigor/libc_interop.cpp --x86 --isa base -O2 -i . -o bin/compiletests-clang/libc_interop_base
compile --clang tests/rigor/libc_interop.cpp --x86 -O2 --def MICRON_INTEROP_STD_FIRST -i . -o bin/compiletests-clang/libc_interop_stdfirst_x86
compile --clang tests/rigor/libc_interop.cpp --i386 -O2 --def MICRON_INTEROP_STD_FIRST -i . -o bin/compiletests-clang/libc_interop_stdfirst_i386
compile --clang tests/rigor/libc_interop.cpp --arm -O2 --def MICRON_INTEROP_STD_FIRST -i . -o bin/compiletests-clang/libc_interop_stdfirst_arm32
compile --clang tests/rigor/libc_interop.cpp --arm64 -O2 --def MICRON_INTEROP_STD_FIRST -i . -o bin/compiletests-clang/libc_interop_stdfirst_arm64
compile --clang tests/rigor/libc_interop.cpp --x86 --isa base -O2 --def MICRON_INTEROP_STD_FIRST -i . -o bin/compiletests-clang/libc_interop_stdfirst_base

# %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# cacheline ops
# cacheline_ops.cpp covers the simd/arch/bits_* backends. arm32's clflush used to emit DCCIMVAC,
# which is PL1-only, so every userspace call SIGILLed; prefetch had a different signature per arch.
compile --clang tests/rigor/cacheline_ops.cpp --x86 -Ofast -i . -o bin/compiletests-clang/cacheline_x86
compile --clang tests/rigor/cacheline_ops.cpp --i386 -Ofast -i . -o bin/compiletests-clang/cacheline_i386
compile --clang tests/rigor/cacheline_ops.cpp --arm -Ofast -i . -o bin/compiletests-clang/cacheline_arm32
compile --clang tests/rigor/cacheline_ops.cpp --arm64 -Ofast -i . -o bin/compiletests-clang/cacheline_arm64
compile --clang tests/rigor/cacheline_ops.cpp --x86 --isa base -O2 -i . -o bin/compiletests-clang/cacheline_base

