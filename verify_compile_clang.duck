# allocator modes
# the directory sweep above covers the disabled/default ABI on every target.
compile --clang tests/compiletests/allocator_types.cpp --x86 --isa base -O2 --raw-obj --def MICRON_ALLOCATOR_STATS --def MICRON_ABC_STATS -o bin/compiletests-clang/allocator_stats_x86
compile --clang tests/compiletests/allocator_types.cpp --i386 -O2 --raw-obj --def MICRON_ALLOCATOR_STATS --def MICRON_ABC_STATS -o bin/compiletests-clang/allocator_stats_i386
compile --clang tests/compiletests/allocator_types.cpp --arm -O2 --raw-obj --def MICRON_ALLOCATOR_STATS --def MICRON_ABC_STATS -o bin/compiletests-clang/allocator_stats_arm32
compile --clang tests/compiletests/allocator_types.cpp --arm64 -O2 --raw-obj --def MICRON_ALLOCATOR_STATS --def MICRON_ABC_STATS -o bin/compiletests-clang/allocator_stats_arm64
compile --clang tests/compiletests/allocator_stats_codegen.cpp --x86 --isa base -O2 --raw-obj --def MICRON_ALLOCATOR_STATS -o bin/compiletests-clang/allocator_stats_codegen_x86
compile --clang tests/compiletests/allocator_types.cpp --x86 --isa base -O2 --raw-obj --def MICRON_ABC_PERSISTENT -o bin/compiletests-clang/allocator_persistent_x86
compile --clang tests/compiletests/allocator_types.cpp --i386 -O2 --raw-obj --def MICRON_ABC_PERSISTENT -o bin/compiletests-clang/allocator_persistent_i386
compile --clang tests/compiletests/allocator_types.cpp --arm -O2 --raw-obj --def MICRON_ABC_PERSISTENT -o bin/compiletests-clang/allocator_persistent_arm32
compile --clang tests/compiletests/allocator_types.cpp --arm64 -O2 --raw-obj --def MICRON_ABC_PERSISTENT -o bin/compiletests-clang/allocator_persistent_arm64

