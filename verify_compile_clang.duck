compile --clang tests/compiletests/elf.cpp --i386 -O2 -i . -o bin/compiletests-clang/elf_i386_O2_ke -ke
compile --clang tests/compiletests/elf.cpp --arm -O2 -i . -o bin/compiletests-clang/elf_arm32_O2_k -k
compile --clang tests/compiletests/elf.cpp --arm -O2 -i . -o bin/compiletests-clang/elf_arm32_O2_ke -ke

compile --clang tests/compiletests/dynamic.cpp --i386 -O0 -i . -o bin/compiletests-clang/dyn_i386_O0_link
compile --clang tests/compiletests/dynamic.cpp --i386 -Ofast -i . -o bin/compiletests-clang/dyn_i386_Ofast_link
compile --clang tests/compiletests/dynamic.cpp --arm -O0 -i . -o bin/compiletests-clang/dyn_arm32_O0_link
compile --clang tests/compiletests/dynamic.cpp --arm -Ofast -i . -o bin/compiletests-clang/dyn_arm32_Ofast_link
compile --clang tests/compiletests/dynamic.cpp --i386 -O2 -i . -o bin/compiletests-clang/dyn_i386_O2_k -k
compile --clang tests/compiletests/dynamic.cpp --i386 -O2 -i . -o bin/compiletests-clang/dyn_i386_O2_ke -ke
compile --clang tests/compiletests/dynamic.cpp --arm -O2 -i . -o bin/compiletests-clang/dyn_arm32_O2_k -k
compile --clang tests/compiletests/dynamic.cpp --arm -O2 -i . -o bin/compiletests-clang/dyn_arm32_O2_ke -ke

# %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# regex

compile --clang tests/compiletests/regex.cpp --x86 --isa base -O0 -i . -o bin/compiletests-clang/regex_base_O0_link
compile --clang tests/compiletests/regex.cpp --x86 --isa base -Ofast -i . -o bin/compiletests-clang/regex_base_Ofast_link
compile --clang tests/compiletests/regex.cpp --x86 --isa v2 -Ofast -i . -o bin/compiletests-clang/regex_v2_Ofast_link
compile --clang tests/compiletests/regex.cpp --i386 -Ofast -i . -o bin/compiletests-clang/regex_i386_Ofast_link
compile --clang tests/compiletests/regex.cpp --arm -Ofast -i . -o bin/compiletests-clang/regex_arm32_Ofast_link
compile --clang tests/compiletests/regex.cpp --arm64 -Ofast -i . -o bin/compiletests-clang/regex_arm64_Ofast_link

# %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# function

compile --clang tests/compiletests/function.cpp --i386 -Ofast -i . -o bin/compiletests-clang/function_i386_Ofast_link
compile --clang tests/compiletests/function.cpp --arm -Ofast -i . -o bin/compiletests-clang/function_arm32_Ofast_link
compile --clang tests/compiletests/function.cpp --arm64 -Ofast -i . -o bin/compiletests-clang/function_arm64_Ofast_link
compile --clang tests/compiletests/function.cpp --x86 --isa base -O2 -i . -o bin/compiletests-clang/function_base_O2_k -k
compile --clang tests/compiletests/function.cpp --x86 --isa base -O2 -i . -o bin/compiletests-clang/function_base_O2_ke -ke

# %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# abcmalloc hardening
compile --clang tests/rigor/abcmalloc_harden.cpp --x86 -Ofast --def MICRON_ABC_ZERO_ON_FREE=true -i . -o bin/compiletests-clang/abc_harden_zero_x86
compile --clang tests/rigor/abcmalloc_harden.cpp --x86 -Ofast --def MICRON_ABC_POISON_ON_FREE=true -i . -o bin/compiletests-clang/abc_harden_poison_x86
compile --clang tests/rigor/abcmalloc_harden.cpp --x86 -Ofast --def MICRON_ABC_REDZONE=true -i . -o bin/compiletests-clang/abc_harden_rz_x86
compile --clang tests/rigor/abcmalloc_harden.cpp --x86 -Ofast --def MICRON_ABC_ENFORCE_PROVENANCE=true -i . -o bin/compiletests-clang/abc_harden_prov_x86
compile --clang tests/rigor/abcmalloc_harden.cpp --i386 -Ofast --def MICRON_ABC_REDZONE=true -i . -o bin/compiletests-clang/abc_harden_rz_i386
compile --clang tests/rigor/abcmalloc_harden.cpp --arm -Ofast --def MICRON_ABC_REDZONE=true -i . -o bin/compiletests-clang/abc_harden_rz_arm32
compile --clang tests/rigor/abcmalloc_harden.cpp --arm64 -Ofast --def MICRON_ABC_ZERO_ON_FREE=true -i . -o bin/compiletests-clang/abc_harden_zero_arm64
compile --clang tests/rigor/abcmalloc_harden.cpp --x86 --isa base -O2 --def MICRON_ABC_REDZONE=true -i . -o bin/compiletests-clang/abc_harden_rz_base

# %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# the crt path override
build --clang tests/compiletests/containers.cpp --x86 -Ofast -k --start ./start -i . -i ./src -o bin/compiletests-clang/amd64_k_startdir
build --clang tests/compiletests/containers.cpp --x86 -Ofast -ke --start ./start -i . -i ./src -o bin/compiletests-clang/amd64_ke_startdir
build --clang tests/compiletests/containers.cpp --x86 -Ofast -k --direct --start ./start -i . -i ./src -o bin/compiletests-clang/amd64_k_direct
# Keep the ARM64 CRT override cell focused on startup plumbing; the C ABI shim
# does not pull the full allocator/math surface into this one targeted row.
build --clang tests/memory/free/cabi_shims_freestanding.cpp --arm64 -Ofast -k --start ./start -i . -i ./src -o bin/compiletests-clang/arm64_k_startdir
