#  duck verify_compile_clang.duck
#  duck batch parallel verify_compile_clang.duck   (pool every cell concurrently)
#
# {amd64, arm64, arm32, i386} x {-O0 -O1 -O2 -O3 -Ofast, debug (-g)} x hosted/freestanding
#   plus  amd64 x {base, v2, v3, v4} ISA levels

# %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# x86 ISA levels
#   base = -march=x86-64     
#   v2   = -march=x86-64-v2 
#   v3   = -march=x86-64-v3 
#   v4   = -march=x86-64-v4 

compile --clang tests/compiletests/ --x86 --isa base -O0 --raw-obj -o bin/compiletests-clang/amd64_base_O0
compile --clang tests/compiletests/ --x86 --isa base -O2 --raw-obj -o bin/compiletests-clang/amd64_base_O2
compile --clang tests/compiletests/ --x86 --isa base -Ofast --raw-obj -o bin/compiletests-clang/amd64_base_Ofast
compile --clang tests/compiletests/ --x86 --isa base -g --raw-obj -o bin/compiletests-clang/amd64_base_debug
compile --clang tests/compiletests/ --x86 --isa v2 -O0 --raw-obj -o bin/compiletests-clang/amd64_v2_O0
compile --clang tests/compiletests/ --x86 --isa v2 -O2 --raw-obj -o bin/compiletests-clang/amd64_v2_O2
compile --clang tests/compiletests/ --x86 --isa v2 -Ofast --raw-obj -o bin/compiletests-clang/amd64_v2_Ofast
compile --clang tests/compiletests/ --x86 --isa v2 -g --raw-obj -o bin/compiletests-clang/amd64_v2_debug
compile --clang tests/compiletests/ --x86 --isa v3 -O2 --raw-obj -o bin/compiletests-clang/amd64_v3_O2
compile --clang tests/compiletests/ --x86 --isa v3 -Ofast --raw-obj -o bin/compiletests-clang/amd64_v3_Ofast
compile --clang tests/compiletests/ --x86 --isa v4 -O2 --raw-obj -o bin/compiletests-clang/amd64_v4_O2
compile --clang tests/compiletests/ --x86 --isa v4 -Ofast --raw-obj -o bin/compiletests-clang/amd64_v4_Ofast

# the same, freestanding
compile --clang tests/compiletests/ --x86 --isa base -O2 --raw-obj -o bin/compiletests-clang/amd64_base_O2_k -ke
compile --clang tests/compiletests/ --x86 --isa base -O2 --raw-obj -o bin/compiletests-clang/amd64_base_O2_knoeh -k
compile --clang tests/compiletests/ --x86 --isa base -Ofast --raw-obj -o bin/compiletests-clang/amd64_base_Ofast_k -ke
compile --clang tests/compiletests/ --x86 --isa base -Ofast --raw-obj -o bin/compiletests-clang/amd64_base_Ofast_knoeh -k
compile --clang tests/compiletests/ --x86 --isa v2 -O2 --raw-obj -o bin/compiletests-clang/amd64_v2_O2_k -ke
compile --clang tests/compiletests/ --x86 --isa v2 -O2 --raw-obj -o bin/compiletests-clang/amd64_v2_O2_knoeh -k
compile --clang tests/compiletests/ --x86 --isa v3 -O2 --raw-obj -o bin/compiletests-clang/amd64_v3_O2_k -ke
compile --clang tests/compiletests/ --x86 --isa v3 -O2 --raw-obj -o bin/compiletests-clang/amd64_v3_O2_knoeh -k
compile --clang tests/compiletests/ --x86 --isa v4 -O2 --raw-obj -o bin/compiletests-clang/amd64_v4_O2_k -ke
compile --clang tests/compiletests/ --x86 --isa v4 -O2 --raw-obj -o bin/compiletests-clang/amd64_v4_O2_knoeh -k

# and link real binaries at the two ends of the range
compile --clang tests/compiletests/ --x86 --isa base -O2 -i . -o bin/compiletests-clang/amd64_base_O2_link
compile --clang tests/compiletests/ --x86 --isa v4 -O2 -i . -o bin/compiletests-clang/amd64_v4_O2_link

