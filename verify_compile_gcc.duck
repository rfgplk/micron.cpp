# abcmalloc hardening
compile tests/rigor/abcmalloc_harden.cpp --x86 -Ofast --def MICRON_ABC_ZERO_ON_FREE=true -o bin/compiletests/abc_harden_zero_x86
compile tests/rigor/abcmalloc_harden.cpp --x86 -Ofast --def MICRON_ABC_POISON_ON_FREE=true -o bin/compiletests/abc_harden_poison_x86
compile tests/rigor/abcmalloc_harden.cpp --x86 -Ofast --def MICRON_ABC_REDZONE=true -o bin/compiletests/abc_harden_rz_x86
compile tests/rigor/abcmalloc_harden.cpp --x86 -Ofast --def MICRON_ABC_ENFORCE_PROVENANCE=true -o bin/compiletests/abc_harden_prov_x86
compile tests/rigor/abcmalloc_harden.cpp --i386 -Ofast --def MICRON_ABC_REDZONE=true -o bin/compiletests/abc_harden_rz_i386
compile tests/rigor/abcmalloc_harden.cpp --arm -Ofast --def MICRON_ABC_REDZONE=true -o bin/compiletests/abc_harden_rz_arm32
compile tests/rigor/abcmalloc_harden.cpp --arm64 -Ofast --def MICRON_ABC_ZERO_ON_FREE=true -o bin/compiletests/abc_harden_zero_arm64
compile tests/rigor/abcmalloc_harden.cpp --x86 --isa base -O2 --def MICRON_ABC_REDZONE=true -o bin/compiletests/abc_harden_rz_base

# %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# vk host allocator
# the tests/compiletests/ sweep above already carries vk_headers.cpp with the counters OFF; these
# rows are the ON column. the block header keeps one layout either way, so what is actually under
# test here is the gated code, not a second ABI.
compile tests/compiletests/vk_headers.cpp --x86 -Ofast --def MICRON_VK_HOST_STATS -o bin/compiletests/vk_stats_x86
compile tests/compiletests/vk_headers.cpp --i386 -Ofast --def MICRON_VK_HOST_STATS -o bin/compiletests/vk_stats_i386
compile tests/compiletests/vk_headers.cpp --arm -Ofast --def MICRON_VK_HOST_STATS -o bin/compiletests/vk_stats_arm32
compile tests/compiletests/vk_headers.cpp --arm64 -Ofast --def MICRON_VK_HOST_STATS -o bin/compiletests/vk_stats_arm64
compile tests/compiletests/vk_headers.cpp --x86 --isa base -O2 --def MICRON_VK_HOST_STATS -o bin/compiletests/vk_stats_base
compile tests/rigor/vk_allocator.cpp --x86 -Ofast --def MICRON_VK_HOST_STATS -o bin/compiletests/vk_alloc_stats_x86
compile tests/rigor/vk_allocator.cpp --arm -Ofast --def MICRON_VK_HOST_STATS -o bin/compiletests/vk_alloc_stats_arm32

# %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# allocator modes
# the directory sweep above covers the disabled/default ABI on every target.
compile tests/compiletests/allocator_types.cpp --x86 --isa base -O2 --raw-obj --def MICRON_ALLOCATOR_STATS --def MICRON_ABC_STATS -o bin/compiletests/allocator_stats_x86
compile tests/compiletests/allocator_types.cpp --i386 -O2 --raw-obj --def MICRON_ALLOCATOR_STATS --def MICRON_ABC_STATS -o bin/compiletests/allocator_stats_i386
compile tests/compiletests/allocator_types.cpp --arm -O2 --raw-obj --def MICRON_ALLOCATOR_STATS --def MICRON_ABC_STATS -o bin/compiletests/allocator_stats_arm32
compile tests/compiletests/allocator_types.cpp --arm64 -O2 --raw-obj --def MICRON_ALLOCATOR_STATS --def MICRON_ABC_STATS -o bin/compiletests/allocator_stats_arm64
compile tests/compiletests/allocator_stats_codegen.cpp --x86 --isa base -O2 --raw-obj --def MICRON_ALLOCATOR_STATS -o bin/compiletests/allocator_stats_codegen_x86
compile tests/compiletests/allocator_types.cpp --x86 --isa base -O2 --raw-obj --def MICRON_ABC_PERSISTENT -o bin/compiletests/allocator_persistent_x86
compile tests/compiletests/allocator_types.cpp --i386 -O2 --raw-obj --def MICRON_ABC_PERSISTENT -o bin/compiletests/allocator_persistent_i386
compile tests/compiletests/allocator_types.cpp --arm -O2 --raw-obj --def MICRON_ABC_PERSISTENT -o bin/compiletests/allocator_persistent_arm32
compile tests/compiletests/allocator_types.cpp --arm64 -O2 --raw-obj --def MICRON_ABC_PERSISTENT -o bin/compiletests/allocator_persistent_arm64

# %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# graph
compile tests/compiletests/graph.cpp --x86 --isa base -O0 --raw-obj -o bin/compiletests/graph_base_O0
compile tests/compiletests/graph.cpp --x86 -Ofast --raw-obj -o bin/compiletests/graph_native_Ofast
compile tests/compiletests/graph.cpp --i386 -O2 --raw-obj -o bin/compiletests/graph_i386_O2
compile tests/compiletests/graph.cpp --arm -O2 --raw-obj -o bin/compiletests/graph_arm32_O2
compile tests/compiletests/graph.cpp --arm64 -O2 --raw-obj -o bin/compiletests/graph_arm64_O2
compile tests/compiletests/graph.cpp --x86 --isa base -O2 --raw-obj -k -o bin/compiletests/graph_base_O2_k
compile tests/compiletests/graph.cpp --x86 --isa base -O2 --raw-obj -ke -o bin/compiletests/graph_base_O2_ke

# %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# opt-in compute DAG and thread-pool adapter
compile tests/compiletests/compute.cpp --x86 --isa base -O0 --raw-obj -o bin/compiletests/compute_base_O0
compile tests/compiletests/compute.cpp --x86 -Ofast --raw-obj -o bin/compiletests/compute_native_Ofast
compile tests/compiletests/compute.cpp --i386 -O2 --raw-obj -o bin/compiletests/compute_i386_O2
compile tests/compiletests/compute.cpp --arm -O2 --raw-obj -o bin/compiletests/compute_arm32_O2
compile tests/compiletests/compute.cpp --arm64 -O2 --raw-obj -o bin/compiletests/compute_arm64_O2
compile tests/compiletests/compute.cpp --x86 --isa base -O2 --raw-obj -k -o bin/compiletests/compute_base_O2_k
compile tests/compiletests/compute.cpp --x86 --isa base -O2 --raw-obj -ke -o bin/compiletests/compute_base_O2_ke

# %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
# the crt path override
build tests/compiletests/containers.cpp --x86 -Ofast -k --start ./start -i . -i ./src -o bin/compiletests/amd64_k_startdir
build tests/compiletests/containers.cpp --x86 -Ofast -ke --start ./start -i . -i ./src -o bin/compiletests/amd64_ke_startdir
build tests/compiletests/containers.cpp --x86 -Ofast -k --direct --start ./start -i . -i ./src -o bin/compiletests/amd64_k_direct
# Keep the ARM64 CRT override cell focused on startup plumbing; the C ABI shim
# does not pull the full allocator/math surface into this one targeted row.
build tests/memory/free/cabi_shims_freestanding.cpp --arm64 -Ofast -k --start ./start -i . -i ./src -o bin/compiletests/arm64_k_startdir

# the mx entry stubs. --mx swaps start*.s for mx/start*.s (__micron_mxc, the entry takes a
# descriptor); --cont links mx/cont*.s alone, which defines _continue and no _start at all, and
# needs both attach macros because they are what compile the body the stub calls.
build tests/mx_entry_sim.cpp --x86 -Ofast -k --mx --start ./start -i . -i ./src -o bin/compiletests/amd64_k_mx
build tests/attach_cont.cpp --x86 -Ofast -k --start ./start -i . -i ./src -o bin/compiletests/amd64_k_continuec
compile tests/support/mx_cont_stub.cpp --x86 -O2 -k --raw-obj --cont --start ./start -i . -i ./src --def MICRON_ATTACH_MODULE --def MICRON_MX_CONTINUATION -o bin/compiletests/amd64_k_cont
compile tests/support/mx_cont_stub.cpp --arm -O2 -k --raw-obj --cont --marm --mtp cp15 --start ./start -i . -i ./src --def MICRON_ATTACH_MODULE --def MICRON_MX_CONTINUATION -o bin/compiletests/arm32_k_cont
